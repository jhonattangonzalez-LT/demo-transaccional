# Imagen para Vercel (Container Images on Vercel Functions).
# Vercel detecta este archivo, construye la imagen y enruta todo el tráfico a ella.
# Requiere la variable de entorno DATABASE_URL (Postgres/Neon) en el proyecto de Vercel.

# ---------- build ----------
FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src ./src
RUN mvn -q -B -DskipTests package && cp target/paylink-*.jar /app.jar

# ---------- runtime ----------
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app.jar app.jar

ENV SPRING_PROFILES_ACTIVE=vercel \
    PORT=80 \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -Xss512k"

EXPOSE 80
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
